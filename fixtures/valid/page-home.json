{
  "schema": 1,
  "id": "home",
  "revision": "2026-11-01.3",
  "title": "Home",
  "sections": [
    {
      "id": "hero",
      "widgets": [
        {
          "id": "w_banner_1",
          "type": "banner",
          "v": 1,
          "data": { "imageUrl": "https://picsum.photos/seed/a/800/450", "title": "Welcome" },
          "style": { "spacing": "md", "radius": "lg", "color": "primary" },
          "action": { "type": "open_screen", "screenId": "offers" },
          "analytics": { "event": "home_banner_tap" },
          "rules": {
            "countries": ["AE"],
            "minAppVersion": "1.2.0",
            "from": "2026-11-01T00:00:00Z",
            "to": "2026-12-01T00:00:00Z"
          },
          "fallback": {
            "id": "w_banner_1_fallback",
            "type": "text",
            "v": 1,
            "data": { "text": "Welcome" },
            "style": { "textSize": "headline" }
          }
        }
      ]
    },
    {
      "id": "services",
      "title": "Services",
      "widgets": [
        {
          "id": "w_header_1",
          "type": "section_header",
          "v": 1,
          "data": { "title": "Popular services", "subtitle": "Book in under a minute", "actionLabel": "See all" },
          "action": { "type": "open_screen", "screenId": "services" }
        },
        {
          "id": "w_carousel_1",
          "type": "carousel",
          "v": 1,
          "data": {
            "autoplay": true,
            "viewportFraction": 0.85,
            "items": [
              {
                "id": "w_card_1",
                "type": "card",
                "v": 1,
                "data": { "title": "Teeth cleaning", "subtitle": "From AED 150", "imageUrl": "https://picsum.photos/seed/c1/800/450" },
                "action": { "type": "open_sheet", "screenId": "cleaning" }
              },
              {
                "id": "w_card_2",
                "type": "card",
                "v": 1,
                "data": {
                  "title": "Health check",
                  "children": [
                    { "id": "w_card_2_text", "type": "text", "v": 1, "data": { "text": "A full check in one visit" } }
                  ]
                }
              }
            ]
          }
        },
        { "id": "w_spacer_1", "type": "spacer", "v": 1, "data": { "size": "md" } },
        { "id": "w_divider_1", "type": "divider", "v": 1, "data": {} }
      ]
    },
    {
      "id": "doctors",
      "title": "Doctors near you",
      "widgets": [
        {
          "id": "w_doctors_1",
          "type": "data_list",
          "v": 1,
          "data": {
            "source": { "name": "doctors_nearby", "params": { "city": "Dubai" } },
            "layout": "list",
            "emptyText": "No doctors found nearby",
            "template": [
              {
                "id": "w_doctor_row",
                "type": "card",
                "v": 1,
                "data": {
                  "title": "{{name}}",
                  "subtitle": "{{specialty}} · {{fee}} AED",
                  "imageUrl": "{{photoUrl}}"
                },
                "action": { "type": "open_native", "name": "doctor_profile", "params": { "doctorId": "{{id}}" } }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "more",
      "widgets": [
        {
          "id": "w_list_1",
          "type": "list",
          "v": 1,
          "data": {
            "dividers": true,
            "items": [
              { "id": "w_list_1_a", "type": "text", "v": 1, "data": { "text": "First item" } },
              { "id": "w_list_1_b", "type": "text", "v": 1, "data": { "text": "Second item", "maxLines": 2 } }
            ]
          }
        },
        {
          "id": "w_grid_1",
          "type": "grid",
          "v": 1,
          "data": {
            "columns": 2,
            "items": [
              { "id": "w_grid_1_a", "type": "image", "v": 1, "data": { "url": "https://picsum.photos/seed/g1/800/450", "alt": "One", "aspectRatio": 1, "fit": "cover" } },
              { "id": "w_grid_1_b", "type": "image", "v": 1, "data": { "url": "https://picsum.photos/seed/g2/800/450", "alt": "Two" } }
            ]
          }
        },
        {
          "id": "w_tabs_1",
          "type": "tabs",
          "v": 1,
          "data": {
            "tabs": [
              {
                "id": "upcoming",
                "label": "Upcoming",
                "widgets": [{ "id": "w_tabs_1_a", "type": "text", "v": 1, "data": { "text": "No upcoming visits" } }]
              },
              {
                "id": "past",
                "label": "Past",
                "widgets": [{ "id": "w_tabs_1_b", "type": "text", "v": 1, "data": { "text": "No past visits" } }]
              }
            ]
          }
        },
        {
          "id": "w_button_1",
          "type": "button",
          "v": 1,
          "data": { "label": "Book a visit", "variant": "filled" },
          "action": { "type": "call_api", "name": "start_booking", "params": { "source": "home" } },
          "analytics": { "event": "home_book_tap", "params": { "position": "bottom" } }
        }
      ]
    }
  ]
}
