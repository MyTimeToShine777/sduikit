{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/common/tokens.json",
  "title": "Design tokens",
  "$comment": "The $id values are only names; nothing is ever fetched from that address.",
  "$defs": {
    "spacing": {
      "enum": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ]
    },
    "radius": {
      "enum": [
        "none",
        "sm",
        "md",
        "lg",
        "full"
      ]
    },
    "color": {
      "enum": [
        "primary",
        "onPrimary",
        "secondary",
        "onSecondary",
        "background",
        "onBackground",
        "surface",
        "onSurface",
        "muted",
        "success",
        "warning",
        "error"
      ]
    },
    "textSize": {
      "enum": [
        "caption",
        "body",
        "title",
        "headline",
        "display"
      ]
    },
    "align": {
      "enum": [
        "start",
        "center",
        "end"
      ]
    },
    "icon": {
      "enum": [
        "home",
        "search",
        "calendar",
        "phone",
        "chat",
        "location",
        "heart",
        "star",
        "info",
        "bag",
        "check",
        "close",
        "warning",
        "error",
        "mail",
        "share",
        "download",
        "lock",
        "clock",
        "gift",
        "cart",
        "camera",
        "play",
        "link",
        "person",
        "settings",
        "payment",
        "bell",
        "bookmark",
        "help"
      ]
    },
    "tone": {
      "enum": [
        "neutral",
        "info",
        "success",
        "warning",
        "error"
      ]
    },
    "size": {
      "enum": [
        "small",
        "medium",
        "large"
      ]
    }
  }
}
