{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/steps.v1.json",
  "title": "steps (v1) data",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "state": {
            "enum": [
              "done",
              "current",
              "todo"
            ]
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "steps"
  ],
  "additionalProperties": false
}
