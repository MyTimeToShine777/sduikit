{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/button.v1.json",
  "title": "button (v1) data",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "enum": [
        "filled",
        "outline",
        "text",
        "tonal",
        "elevated"
      ]
    },
    "icon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "iconPosition": {
      "enum": [
        "start",
        "end"
      ]
    },
    "size": {
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "fullWidth": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "loading": {
      "type": "boolean"
    },
    "tooltip": {
      "type": "string"
    }
  },
  "required": [
    "label"
  ],
  "additionalProperties": false
}
