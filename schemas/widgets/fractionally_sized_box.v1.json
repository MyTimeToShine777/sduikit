      "maximum": 10
    },
    "alignment": {
      "$ref": "../common/layout.json#/$defs/alignment"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "../common/widget.json"
      },
      "maxItems": 1
    }
  },
  "additionalProperties": false
}
