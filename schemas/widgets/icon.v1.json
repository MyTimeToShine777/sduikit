{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/icon.v1.json",
  "title": "icon (v1) data",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "size": {
      "$ref": "../common/layout.json#/$defs/iconSize"
    },
    "color": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "rotation": {
      "type": "number",
      "minimum": -360,
      "maximum": 360
    },
    "flipX": {
      "type": "boolean"
    },
    "background": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "shape": {
      "enum": [
        "none",
        "circle",
        "square",
        "rounded"
      ]
    },
    "padding": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "tooltip": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
