{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/list_item.v1.json",
  "title": "list_item (v1) data",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "icon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "imageUrl": {
      "type": "string",
      "format": "uri"
    },
    "trailingText": {
      "type": "string"
    },
    "chevron": {
      "type": "boolean"
    },
    "dense": {
      "type": "boolean"
    },
    "selected": {
      "type": "boolean"
    },
    "trailingIcon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "imageSize": {
      "type": "number",
      "minimum": 16,
      "maximum": 120
    },
    "imageShape": {
      "enum": [
        "circle",
        "rounded",
        "square"
      ]
    },
    "titleMaxLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "subtitleMaxLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "badge": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
