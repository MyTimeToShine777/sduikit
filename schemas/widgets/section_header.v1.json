{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/section_header.v1.json",
  "title": "section_header (v1) data",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "actionLabel": {
      "type": "string"
    },
    "icon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "actionIcon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "showDivider": {
      "type": "boolean"
    },
    "titleMaxLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "uppercase": {
      "type": "boolean"
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
