{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/carousel.v1.json",
  "title": "carousel (v1) data",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "../common/widget.json"
      },
      "minItems": 1
    },
    "autoplay": {
      "type": "boolean"
    },
    "viewportFraction": {
      "type": "number",
      "minimum": 0.3,
      "maximum": 1
    },
    "height": {
      "type": "number",
      "minimum": 40,
      "maximum": 1200
    },
    "autoplayInterval": {
      "type": "number",
      "minimum": 1,
      "maximum": 60
    },
    "showDots": {
      "type": "boolean"
    },
    "spacing": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "enlargeCenter": {
      "type": "boolean"
    },
    "initialIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "loop": {
      "type": "boolean"
    },
    "animationDuration": {
      "type": "integer",
      "minimum": 50,
      "maximum": 5000
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
