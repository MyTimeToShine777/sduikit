{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/chips.v1.json",
  "title": "chips (v1) data",
  "type": "object",
  "properties": {
    "chips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "boolean"
          },
          "action": {
            "$ref": "../common/action.json"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "chips"
  ],
  "additionalProperties": false
}
