{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/chips.v1.json",
  "title": "chips (v1) data",
  "type": "object",
  "properties": {
    "chips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "boolean"
          },
          "action": {
            "$ref": "../common/action.json"
          },
          "icon": {
            "$ref": "../common/tokens.json#/$defs/icon"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri"
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "variant": {
      "enum": [
        "filter",
        "choice",
        "input",
        "assist"
      ]
    },
    "spacing": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "runSpacing": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "scrollable": {
      "type": "boolean"
    },
    "alignment": {
      "$ref": "../common/layout.json#/$defs/mainAxisAlignment"
    }
  },
  "required": [
    "chips"
  ],
  "additionalProperties": false
}
