{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/tabs.v1.json",
  "title": "tabs (v1) data",
  "type": "object",
  "properties": {
    "tabs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "widgets": {
            "type": "array",
            "items": {
              "$ref": "../common/widget.json"
            }
          },
          "icon": {
            "$ref": "../common/tokens.json#/$defs/icon"
          }
        },
        "required": [
          "id",
          "label",
          "widgets"
        ],
        "additionalProperties": false
      }
    },
    "initialIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "variant": {
      "enum": [
        "chips",
        "underline",
        "segmented"
      ]
    },
    "scrollable": {
      "type": "boolean"
    },
    "tabAlignment": {
      "enum": [
        "start",
        "center",
        "end",
        "stretch"
      ]
    }
  },
  "required": [
    "tabs"
  ],
  "additionalProperties": false
}
