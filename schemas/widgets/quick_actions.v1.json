{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/quick_actions.v1.json",
  "title": "quick_actions (v1) data",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "$ref": "../common/tokens.json#/$defs/icon"
          },
          "action": {
            "$ref": "../common/action.json"
          },
          "badge": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "icon"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "columns": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6
    },
    "shape": {
      "enum": [
        "circle",
        "rounded",
        "square"
      ]
    },
    "iconSize": {
      "type": "number",
      "minimum": 12,
      "maximum": 100
    },
    "size": {
      "type": "number",
      "minimum": 24,
      "maximum": 120
    },
    "showLabels": {
      "type": "boolean"
    },
    "spacing": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "labelMaxLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
