{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/rich_text.v1.json",
  "title": "rich_text (v1) data",
  "type": "object",
  "properties": {
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "bold": {
            "type": "boolean"
          },
          "italic": {
            "type": "boolean"
          },
          "underline": {
            "type": "boolean"
          },
          "color": {
            "$ref": "../common/style.json#/$defs/colour"
          },
          "size": {
            "$ref": "../common/style.json#/$defs/textSize"
          },
          "strikethrough": {
            "type": "boolean"
          },
          "background": {
            "$ref": "../common/style.json#/$defs/colour"
          },
          "action": {
            "$ref": "../common/action.json"
          },
          "weight": {
            "enum": [
              "normal",
              "medium",
              "bold"
            ]
          },
          "letterSpacing": {
            "type": "number",
            "minimum": -5,
            "maximum": 50
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "selectable": {
      "type": "boolean"
    }
  },
  "required": [
    "spans"
  ],
  "additionalProperties": false
}
