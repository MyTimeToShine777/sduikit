{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/grid.v1.json",
  "title": "grid (v1) data",
  "type": "object",
  "properties": {
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "../common/widget.json"
      },
      "minItems": 1
    },
    "mainAxisSpacing": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "crossAxisSpacing": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "childAspectRatio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 20
    }
  },
  "required": [
    "columns",
    "items"
  ],
  "additionalProperties": false
}
