{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/quote.v1.json",
  "title": "quote (v1) data",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "avatarUrl": {
      "type": "string",
      "format": "uri"
    },
    "showBar": {
      "type": "boolean"
    },
    "barColor": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "barWidth": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "italic": {
      "type": "boolean"
    },
    "avatarSize": {
      "type": "number",
      "minimum": 16,
      "maximum": 120
    },
    "showQuoteMark": {
      "type": "boolean"
    }
  },
  "required": [
    "text"
  ],
  "additionalProperties": false
}
