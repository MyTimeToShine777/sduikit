{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/key_value.v1.json",
  "title": "key_value (v1) data",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "icon": {
            "$ref": "../common/tokens.json#/$defs/icon"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "dividers": {
      "type": "boolean"
    },
    "layout": {
      "enum": [
        "sideBySide",
        "stacked"
      ]
    },
    "valueAlign": {
      "enum": [
        "start",
        "end"
      ]
    },
    "labelFraction": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 0.9
    }
  },
  "required": [
    "rows"
  ],
  "additionalProperties": false
}
