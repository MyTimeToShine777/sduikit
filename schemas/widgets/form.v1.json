{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/form.v1.json",
  "title": "form (v1) data",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "enum": [
              "text",
              "email",
              "number",
              "multiline",
              "password",
              "checkbox",
              "switch",
              "select",
              "date"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "placeholder": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "helperText": {
            "type": "string"
          },
          "initialValue": {
            "type": "string"
          },
          "minLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "pattern": {
            "type": "string"
          },
          "patternMessage": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "readOnly": {
            "type": "boolean"
          },
          "icon": {
            "$ref": "../common/tokens.json#/$defs/icon"
          }
        },
        "required": [
          "name",
          "type",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "submitLabel": {
      "type": "string",
      "minLength": 1
    },
    "spacing": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "fieldVariant": {
      "enum": [
        "outlined",
        "filled",
        "underline"
      ]
    },
    "submitFullWidth": {
      "type": "boolean"
    },
    "submitIcon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "resetLabel": {
      "type": "string"
    }
  },
  "required": [
    "fields",
    "submitLabel"
  ],
  "additionalProperties": false
}
