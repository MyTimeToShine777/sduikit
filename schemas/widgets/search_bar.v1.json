{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/search_bar.v1.json",
  "title": "search_bar (v1) data",
  "type": "object",
  "properties": {
    "placeholder": {
      "type": "string",
      "minLength": 1
    },
    "leadingIcon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "trailingIcon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "filled": {
      "type": "boolean"
    },
    "height": {
      "type": "number",
      "minimum": 24,
      "maximum": 120
    }
  },
  "required": [
    "placeholder"
  ],
  "additionalProperties": false
}
