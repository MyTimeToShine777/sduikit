{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/list.v1.json",
  "title": "list (v1) data",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "../common/widget.json"
      },
      "minItems": 1
    },
    "dividers": {
      "type": "boolean"
    },
    "spacing": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "height": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000
    },
    "reverse": {
      "type": "boolean"
    },
    "dividerIndent": {
      "$ref": "../common/style.json#/$defs/space"
    },
    "dividerThickness": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
