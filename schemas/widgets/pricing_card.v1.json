{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/pricing_card.v1.json",
  "title": "pricing_card (v1) data",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "price": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "highlighted": {
      "type": "boolean"
    },
    "ctaLabel": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "additionalProperties": false
}
