{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/table.v1.json",
  "title": "table (v1) data",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "striped": {
      "type": "boolean"
    },
    "border": {
      "enum": [
        "none",
        "all",
        "horizontal"
      ]
    },
    "columnAlign": {
      "type": "array",
      "items": {
        "enum": [
          "start",
          "center",
          "end"
        ]
      }
    },
    "columnWidths": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.05,
        "maximum": 20
      }
    },
    "dense": {
      "type": "boolean"
    },
    "firstColumnBold": {
      "type": "boolean"
    }
  },
  "required": [
    "columns",
    "rows"
  ],
  "additionalProperties": false
}
