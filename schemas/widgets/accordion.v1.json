{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/accordion.v1.json",
  "title": "accordion (v1) data",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "widgets": {
            "type": "array",
            "items": {
              "$ref": "../common/widget.json"
            }
          },
          "subtitle": {
            "type": "string"
          },
          "icon": {
            "$ref": "../common/tokens.json#/$defs/icon"
          }
        },
        "required": [
          "title",
          "widgets"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "allowMultiple": {
      "type": "boolean"
    },
    "initiallyOpen": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 200
      }
    },
    "dividers": {
      "type": "boolean"
    },
    "iconPosition": {
      "enum": [
        "start",
        "end"
      ]
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
