{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/accordion.v1.json",
  "title": "accordion (v1) data",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "widgets": {
            "type": "array",
            "items": {
              "$ref": "../common/widget.json"
            }
          }
        },
        "required": [
          "title",
          "widgets"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "allowMultiple": {
      "type": "boolean"
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
