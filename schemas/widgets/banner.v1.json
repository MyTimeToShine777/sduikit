{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/banner.v1.json",
  "title": "banner (v1) data",
  "type": "object",
  "properties": {
    "imageUrl": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "height": {
      "type": "number",
      "minimum": 40,
      "maximum": 800
    },
    "overlayColor": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "overlayOpacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "contentAlignment": {
      "$ref": "../common/layout.json#/$defs/alignment"
    },
    "imageFit": {
      "$ref": "../common/layout.json#/$defs/boxFit"
    },
    "ctaLabel": {
      "type": "string"
    }
  },
  "required": [
    "imageUrl"
  ],
  "additionalProperties": false
}
