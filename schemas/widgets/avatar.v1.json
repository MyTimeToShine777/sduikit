{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/avatar.v1.json",
  "title": "avatar (v1) data",
  "type": "object",
  "properties": {
    "imageUrl": {
      "type": "string",
      "format": "uri"
    },
    "initials": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3
    },
    "size": {
      "$ref": "../common/layout.json#/$defs/iconSize"
    },
    "shape": {
      "enum": [
        "circle",
        "rounded",
        "square"
      ]
    },
    "backgroundColor": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "foregroundColor": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "status": {
      "enum": [
        "none",
        "online",
        "offline",
        "busy",
        "away"
      ]
    },
    "borderColor": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "borderWidth": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    }
  },
  "additionalProperties": false,
  "minProperties": 1
}
