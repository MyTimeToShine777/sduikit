{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/rating.v1.json",
  "title": "rating (v1) data",
  "type": "object",
  "properties": {
    "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "label": {
      "type": "string"
    },
    "max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "size": {
      "type": "number",
      "minimum": 8,
      "maximum": 64
    },
    "icon": {
      "enum": [
        "star",
        "heart",
        "thumb",
        "circle"
      ]
    },
    "color": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "emptyColor": {
      "$ref": "../common/style.json#/$defs/colour"
    },
    "showValue": {
      "type": "boolean"
    },
    "showCount": {
      "type": "boolean"
    }
  },
  "required": [
    "value"
  ],
  "additionalProperties": false
}
