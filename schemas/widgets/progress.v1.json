{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/progress.v1.json",
  "title": "progress (v1) data",
  "type": "object",
  "properties": {
    "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "label": {
      "type": "string"
    },
    "shape": {
      "enum": [
        "linear",
        "circular"
      ]
    },
    "indeterminate": {
      "type": "boolean"
    },
    "strokeWidth": {
      "type": "number",
      "minimum": 1,
      "maximum": 40
    },
    "size": {
      "type": "number",
      "minimum": 16,
      "maximum": 300
    },
    "showPercent": {
      "type": "boolean"
    },
    "rounded": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
