{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sduikit.dev/schemas/widgets/stat.v1.json",
  "title": "stat (v1) data",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "delta": {
      "type": "string"
    },
    "trend": {
      "enum": [
        "up",
        "down",
        "flat"
      ]
    },
    "icon": {
      "$ref": "../common/tokens.json#/$defs/icon"
    },
    "prefix": {
      "type": "string"
    },
    "suffix": {
      "type": "string"
    }
  },
  "required": [
    "label",
    "value"
  ],
  "additionalProperties": false
}
