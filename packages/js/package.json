{
  "name": "sduikit",
  "version": "0.1.0",
  "description": "Server-driven UI toolkit: shared schemas, validation and client filtering.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./vue": { "types": "./dist/vue/index.d.ts", "import": "./dist/vue/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": { "optional": true }
  }
}
